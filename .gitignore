# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ---- Ambientes virtuais ----
.venv/
venv/
env/

# ---- Dados pessoais do usuário (não versionar) ----
# Os gastos reais ficam fora do repositório. Use gastos.exemplo.json como base.
gastos.json

# ---- Logos dos bancos (marcas registradas, cada um coloca os seus) ----
assets/logos/*
!assets/logos/.gitkeep

# ---- IDEs / editores ----
.vscode/
.idea/
*.swp

# ---- Arquivos de sistema operacional ----
.DS_Store
Thumbs.db

# ---- Executável (PyInstaller) ----
build/
dist/
*.spec
